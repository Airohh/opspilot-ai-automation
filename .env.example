# Copy this file to .env and fill the empty values.
# Do not commit .env.

# Enter this key in the n8n credential screen (OpenAI, Anthropic, or Mistral).
# FastAPI does not read it, and it is not injected into the n8n container environment.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Notion integration token, shared only with the AI Automation Lab page.
# Used by FastAPI. Not injected into n8n.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# Local demo token between n8n and FastAPI. Not a production secret.
INTERNAL_API_TOKEN=change-me-local-only

# Header tokens for the n8n webhook and the approval URL.
# Enter each one in an n8n Header Auth credential (see README). Use two different values.
OPSPILOT_WEBHOOK_TOKEN=change-me-requester
OPSPILOT_APPROVER_TOKEN=change-me-approver

# Local Postgres password. Not a production secret.
POSTGRES_PASSWORD=opspilot-local
DATABASE_URL=postgresql+psycopg://opspilot:opspilot-local@postgres:5432/opspilot

# Set by Docker Compose inside the network. Present here for local runs outside Compose.
SUPPLIER_API_URL=http://localhost:8080

# Stable key so n8n credentials survive a container recreate. Use a long random string.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
