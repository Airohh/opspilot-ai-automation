      "parameters": {
        "promptType": "define",
        "text": "={{ 'The supplier record and the policy are already included. Do not call Supplier API Tool, Policy Tool, or Notion Read Tool. Reply with one JSON object and no markdown. Keys: request_summary, information_consulted, facts, assumptions, analysis, proposed_action, expected_impact, requires_human_approval, clarification_needed, tools_used. requires_human_approval must be true.\\nrequest_id: ' + $('Normalize Request').first().json.request_id + '\\nrequest: ' + $('Normalize Request').first().json.request + '\\nsupplier: ' + JSON.stringify($('Load Supplier').first().json) + '\\npolicy: ' + JSON.stringify($('Load Policy').first().json) }}",
