    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const prepared = $('Prepare Proposal').first().json;\nconst proposal = prepared.proposal;\nreturn [{ json: { request_id: prepared.request_id, status: 'Waiting Approval', request_summary: proposal.request_summary, information_consulted: proposal.information_consulted, facts: proposal.facts, assumptions: proposal.assumptions, analysis: proposal.analysis, proposed_action: proposal.proposed_action, expected_impact: proposal.expected_impact, tools_used: proposal.tools_used, approval_url: $execution.resumeUrl, how_to_approve: 'POST {\"decision\":\"approved\",\"approved_by\":\"your-name\"} to approval_url with the X-OpsPilot-Approver-Token header. Use decision rejected to stop without applying the action. Without a decision within 24 hours the request is rejected.', clarification_needed: proposal.clarification_needed === true, fallback_used: proposal.fallback_used === true, demonstration_data: true } }];"
      },
      "id": "b6c1a001-0001-4000-8000-000000000014",
