    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.LLM_MODEL }}"
        },
        "responsesApiEnabled": false,
        "options": {
          "extraBody": "={{ JSON.stringify({ response_format: { type: 'json_schema', json_schema: { name: 'opspilot_proposal', strict: true, schema: $('Load System Prompt').first().json.output_schema } } }) }}"
        }
      },
      "id": "b6c1a001-0001-4000-8000-000000000007",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1280,
        560
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const intake = $('Normalize Request').first().json;\nconst supplier = $('Load Supplier').first().json;\nconst policy = $('Load Policy').first().json;\nconst schema = $('Load System Prompt').first().json.output_schema;\nfunction parse(raw) {\n  if (raw && typeof raw === 'object') return raw;\n  const text = String(raw ?? '').trim().replace(/^```(?:json)?\\s*/, '').replace(/\\s*```$/, '');\n  try { return JSON.parse(text); } catch (error) { return null; }\n}\nfunction matchesSchema(value) {\n  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;\n  return schema.required.every((key) => {\n    const expected = schema.properties[key].type;\n    const item = value[key];\n    if (expected === 'array') return Array.isArray(item) && item.every((entry) => typeof entry === 'string');\n    return typeof item === expected;\n  });\n}\nfunction ruleBasedProposal() {\n  const current = Number(supplier.payment_terms);\n  const numbers = String(intake.request).match(/\\d+/g) || [];\n  const requested = numbers.map(Number).find((n) => n !== current) || current;\n  const delta = requested - current;\n  const active = supplier.contract_status === 'active';\n  let analysis = 'Procurement approval is required before any change.';\n  if (!active) analysis = 'The contract is ' + supplier.contract_status + ', so a payment-term change needs clarification first.';\n  else if (delta > 15) analysis = 'The change is ' + delta + ' days, above 15 days, so Procurement Director approval is required.';\n  return {\n    request_summary: supplier.id + ' asks to move payment terms from ' + current + ' to ' + requested + ' days.',\n    information_consulted: ['Supplier ' + supplier.id + ' (demonstration data)', ...(policy.results || []).map((item) => item.source)],\n    facts: ['Current payment terms: ' + current + ' days.', 'Requested payment terms: ' + requested + ' days.', 'Contract status: ' + supplier.contract_status + '.'],\n    assumptions: ['The model reply did not match the proposal schema, so a fixed rule built this proposal from the supplier record and the policy.'],\n    analysis,\n    proposed_action: active ? 'Ask for approval of the change. Do not change payment terms yet.' : 'Ask the requester to clarify the contract status before any change.',\n    expected_impact: 'No payment term is changed until a human approves.',\n    clarification_needed: !active\n  };\n}\nconst reply = parse($json.text);\nconst fallbackUsed = !matchesSchema(reply);\nconst proposal = fallbackUsed ? ruleBasedProposal() : reply;\nproposal.requires_human_approval = true;\n// What the workflow retrieved before the model call. The model has no tools.\nproposal.tools_used = ['supplier_match', 'policy_search'];\nproposal.fallback_used = fallbackUsed;\nreturn [{ json: { request_id: intake.request_id, requester: intake.requester, request: intake.request, proposal } }];"
      },
      "id": "b6c1a001-0001-4000-8000-000000000012",
      "name": "Prepare Proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        320
