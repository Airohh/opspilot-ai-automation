    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "let requestId = null;\n// Output 0 is the intake result. Without the index, n8n reads the error output\n// that links Normalize Request directly to this node, which is empty.\ntry { requestId = $('Normalize Request').first(0).json.request_id; } catch (error) {}\nconst err = $json.error;\nconst raw = (typeof err === 'string' ? err : err && err.message) || $json.message || JSON.stringify($json);\nfunction readable(text) {\n  const match = /^\\d{3} - (\".*\")$/s.exec(text);\n  if (!match) return text;\n  try {\n    const body = JSON.parse(JSON.parse(match[1]));\n    return typeof body.detail === 'string' ? body.detail : text;\n  } catch (error) {\n    return text;\n  }\n}\nreturn [{ json: { request_id: requestId, error_message: readable(String(raw)).slice(0, 500) } }];"
      },
