    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "if ($json.body === undefined) {\n  return [{ json: { decision: 'rejected', approved_by: 'system:timeout', error_message: 'No decision within 24 hours. Treated as rejected so no write action runs.' } }];\n}\nconst body = $json.body;\nconst decision = String(body.decision || '').toLowerCase();\nconst approvedBy = body.approved_by || 'unknown';\nif (decision !== 'approved' && decision !== 'rejected') {\n  return [{ json: { decision: 'rejected', approved_by: approvedBy, error_message: 'Missing decision. Treated as rejected so no write action runs.' } }];\n}\nreturn [{ json: { decision, approved_by: approvedBy } }];"
      },
