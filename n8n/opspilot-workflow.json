        "jsCode": "const body = $json.body ?? $json;\nconst decision = String(body.decision || '').toLowerCase();\nconst approvedBy = body.approved_by || 'unknown';\nif (decision !== 'approved' && decision !== 'rejected') {\n  return [{ json: { decision: 'rejected', approved_by: approvedBy, error_message: 'Missing decision. Treated as rejected so no write action runs.' } }];\n}\nreturn [{ json: { decision, approved_by: approvedBy } }];"
