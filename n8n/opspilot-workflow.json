        "jsCode": "let requestId = null;\ntry { requestId = $('Normalize Request').all()[0].json.request_id; } catch (error) {}\nconst err = $json.error;\nconst raw = (typeof err === 'string' ? err : err && err.message) || $json.message || JSON.stringify($json);\nreturn [{ json: { request_id: requestId, error_message: String(raw).slice(0, 500) } }];"
